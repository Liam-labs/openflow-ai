# Copy to .env (the setup script does this for you) and fill in what you use. Never commit .env.
# Lines starting with # are comments. An empty value means "not set".

# --- The dashboard -----------------------------------------------------------
# Port the dashboard listens on. It binds to 127.0.0.1 (this machine only) unless you change that on purpose.
PORT=3000
# Address `npm start` binds to. 127.0.0.1 = this machine only. Change it only if you mean to expose the dashboard, and then protect it.
DEVFLOW_BIND_HOST=127.0.0.1
# Where OpenFlow keeps its data and scripts. Leave empty to use the folder this file sits in.
DEVFLOW_HOME=
# Address agents and scripts use to reach the dashboard.
DEVFLOW_URL=http://localhost:3000
# Folders for the app's own data and your data, relative to DEVFLOW_HOME.
DEVFLOW_APP_DATA_DIR=.AppData
DEVFLOW_USER_DATA_DIR=.UserData

# --- Access token ------------------------------------------------------------
# Created for you by the setup script. Anything that calls the API sends it as "Authorization: Bearer <token>".
DEVFLOW_API_TOKEN=

# --- People -------------------------------------------------------------------
# Names shown in the chat and used in agent instructions. Unset: "the owner", "the Architect", "the Team Lead".
# The owner name is read when the app is built, so rebuild after changing it (the build scripts load this file).
DEVFLOW_OWNER_NAME=
NEXT_PUBLIC_DEVFLOW_OWNER_NAME=
DEVFLOW_ARCHITECT_NAME=
DEVFLOW_LEAD_NAME=

# --- Agent accounts -------------------------------------------------------------
# Default route: your own API keys. Fill in the providers you use. These are read by the agents you start on this machine.
# Signing in to a provider's own command-line tool with your personal account is also possible; that is governed by the
# provider's terms and is yours to check. Never share one login between several people.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=

# --- Optional services ---------------------------------------------------------
# Vector search for the knowledge base. Optional: without it the dashboard works and agent memory search is simply unavailable.
# To try it: docker run -d -p 127.0.0.1:6333:6333 qdrant/qdrant   (then leave this line as it is)
QDRANT_URL=http://localhost:6333
# A helper that runs PM2 and scripts on the HOST when the dashboard itself runs in a container. Leave these two OFF for a normal
# install: the dashboard then runs those commands itself. Turning the URL on without a running helper breaks the Services page.
# HOST_BRIDGE_URL=http://localhost:3001
# HOST_BRIDGE_TOKEN=

# --- Safety switches -------------------------------------------------------------
# Requests from this machine are trusted without the token, but only when sent to localhost or a name listed here.
# enforce (default) refuses others; report only logs what it would refuse (use it for a day when adding a proxy); off disables the check.
DEVFLOW_ORIGIN_CHECK=enforce
# Extra names you use on purpose, comma separated (for example a reverse-proxy name).
DEVFLOW_ALLOWED_HOSTS=
DEVFLOW_ALLOWED_ORIGINS=
# 1 ends same-machine trust completely: every request needs the access token. Set it when exposing the dashboard to a network.
DEVFLOW_REQUIRE_TOKEN=0
# 1 trusts other machines on a Tailscale network without a token. Leave at 0 unless you know you want that.
DEVFLOW_TRUST_TAILNET=0

# --- Slack and Teams bridges -----------------------------------------------------
# 1 lets a message from Slack or Teams reuse your dashboard participant when the sender's display name matches yours.
# Leave it at 0: a display name is not proof of who someone is, so a match by name alone could let another person speak as you.
DEVFLOW_BRIDGE_REUSE_PARTICIPANT_BY_NAME=0

# --- Where keys are kept ---------------------------------------------------------
# file (default): keys the setup wizard saves go to .AppData/secrets.json (mode 0600). The app reads that file itself when it starts
#                 and fills only variables that are not already set, so a value from your shell or a launcher always wins. Nothing
#                 runs that file as a script.
# env: read-only; the app takes keys only from its environment (use this when Docker, systemd or a secrets launcher provides them).
DEVFLOW_SECRET_STORE=file
# Move the file somewhere else (keep it private to you).
DEVFLOW_SECRETS_FILE=
# 1 also writes ~/.secrets, a file your shells run on every start, so keys appear in your own terminals. Off by default: anything that can write that file can run commands as you.
DEVFLOW_WRITE_SHELL_SECRETS=0
