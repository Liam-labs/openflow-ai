#!/usr/bin/env python3
"""Owner password for the dashboard sign-in (the page other computers use at /login). Run this ON the machine that runs the app.

    scripts/devflow-password status      is a password set, and how many browsers are signed in
    scripts/devflow-password set         choose a new password (asked twice; the password is never printed); ends every session
    scripts/devflow-password set --stdin read the password from standard input instead of asking
    scripts/devflow-password reset       lock-out recovery: forget the password and every session (sign-in is off until you set one)
    scripts/devflow-password backup      copy the current password to the protected backup folder (set does this by itself)

Protection: every `set` saves a copy to ~/.local/state/devflow-auth-backup (0600, outside the repo and .AppData, last 5 dated copies).
If DevFlow starts and the live file has no password but that backup (under 30 days old) does, DevFlow puts it back and raises an alert.
`reset` records a deliberate-reset marker so the backup is NOT put back after you removed the password on purpose.
During tests (NODE_ENV=test or VITEST) this script refuses to touch a file outside the temporary folder.

This machine itself never needs the password: the dashboard opens here without it. The file is .AppData/dashboard-auth.json (0600).
"""

from __future__ import annotations

import argparse
import getpass
import glob
import hashlib
import json
import os
import secrets
import sys
import tempfile
import time
import unicodedata
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
DATA_DIR = os.environ.get("DEVFLOW_APP_DATA_DIR") or os.environ.get("DEVFLOW_DATA_DIR") or ".AppData"
STORE = (REPO / DATA_DIR / "dashboard-auth.json") if not os.path.isabs(DATA_DIR) else Path(DATA_DIR) / "dashboard-auth.json"

BACKUP_DIR_ENV = os.environ.get("DEVFLOW_AUTH_BACKUP_DIR", "").strip()
UNDER_TEST = os.environ.get("NODE_ENV") == "test" or bool(os.environ.get("VITEST"))
KEEP_DATED = 5
# Backup folder format and rules must match lib/dashboard-auth-backup.ts


def inside_tmp(path: Path) -> bool:
    tmp = Path(tempfile.gettempdir()).resolve()
    target = path.resolve()
    return target == tmp or tmp in target.parents


def refuse_if_test_outside_tmp(path: Path) -> None:
    if UNDER_TEST and not inside_tmp(path):
        sys.exit(f"Refusing to touch {path} during a test run: use a folder inside {tempfile.gettempdir()} (set DEVFLOW_APP_DATA_DIR). Nothing was changed.")


def backup_dir() -> Path | None:
    if BACKUP_DIR_ENV:
        return Path(BACKUP_DIR_ENV)
    if UNDER_TEST:
        return None
    return Path.home() / ".local" / "state" / "devflow-auth-backup"


def write_private(path: Path, text: str) -> None:
    fd, tmp = tempfile.mkstemp(prefix=path.name + ".tmp.", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as handle:
            os.fchmod(handle.fileno(), 0o600)
            handle.write(text)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def save_backup(data: dict) -> str:
    """Copy the password (no sessions) to the protected folder. Returns a short word for the caller to print."""
    folder = backup_dir()
    if folder is None:
        return "backup is off during tests"
    if not data.get("password"):
        return "no password to back up"
    refuse_if_test_outside_tmp(folder)
    folder.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(folder, 0o700)
    body = json.dumps({"version": 1, "password": data["password"], "sessions": {}, "attempts": {}, "globalAttempts": {"count": 0, "firstAt": 0}}, indent=2)
    write_private(folder / ("dashboard-auth." + time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()) + ".json"), body)
    write_private(folder / "dashboard-auth.json", body)
    try:
        (folder / "deliberate-reset.json").unlink()
    except FileNotFoundError:
        pass
    dated = sorted(glob.glob(str(folder / "dashboard-auth.????????T??????Z.json")))
    for old in dated[:-KEEP_DATED]:
        os.unlink(old)
    return f"backup saved in {folder}"


def mark_deliberate_reset() -> None:
    folder = backup_dir()
    if folder is None:
        return
    refuse_if_test_outside_tmp(folder)
    folder.mkdir(parents=True, exist_ok=True, mode=0o700)
    write_private(folder / "deliberate-reset.json", json.dumps({"at": time.strftime("%Y-%m-%dT%H:%M:%S.000Z", time.gmtime()), "pid": os.getpid()}, indent=2))


def backup_status() -> str:
    folder = backup_dir()
    if folder is None:
        return "off during tests"
    marker = folder / "deliberate-reset.json"
    latest = folder / "dashboard-auth.json"
    if marker.exists():
        return "deliberate reset recorded; the backup will not be restored"
    if latest.exists():
        age = int((time.time() - latest.stat().st_mtime) / 86400)
        return f"saved {age} day(s) ago in {folder}"
    return "none yet"


# Must match lib/dashboard-auth.ts
MIN_LENGTH = 12
MAX_LENGTH = 256
N, R, P, KEY_LENGTH = 16384, 8, 1, 64
COMMON = {
    "password1234", "passwordpassword", "123456789012", "1234567890123", "qwertyuiopas", "qwertyuiop12", "letmeinletmein",
    "iloveyou1234", "administrator", "welcome12345", "changeme1234", "devflow12345", "openflow1234",
}


def problem(password: str) -> str | None:
    if len(password) < MIN_LENGTH:
        return f"Use at least {MIN_LENGTH} characters. A few ordinary words in a row is fine."
    if len(password) > MAX_LENGTH:
        return f"Use at most {MAX_LENGTH} characters."
    if password.lower() in COMMON or len(set(password)) == 1 or len(set(password)) < 5:
        return "That password is too easy to guess. Pick something else."
    return None


def hash_password(password: str) -> str:
    salt = secrets.token_bytes(16)
    key = hashlib.scrypt(unicodedata.normalize("NFKC", password).encode(), salt=salt, n=N, r=R, p=P, maxmem=128 * N * R * 2, dklen=KEY_LENGTH)
    return "$".join(["scrypt", str(N), str(R), str(P), salt.hex(), key.hex()])


def load() -> dict:
    try:
        data = json.loads(STORE.read_text())
    except FileNotFoundError:
        data = {}
    except (ValueError, OSError) as error:
        sys.exit(f"{STORE} cannot be read ({error}). Nothing was changed.")
    data.setdefault("version", 1)
    data.setdefault("sessions", {})
    data.setdefault("attempts", {})
    data.setdefault("globalAttempts", {"count": 0, "firstAt": 0})
    return data


def save(data: dict) -> None:
    refuse_if_test_outside_tmp(STORE)
    STORE.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=STORE.name + ".tmp.", dir=STORE.parent)
    try:
        with os.fdopen(fd, "w") as handle:
            os.fchmod(handle.fileno(), 0o600)
            json.dump(data, handle, indent=2)
        os.replace(tmp, STORE)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def live_sessions(data: dict) -> int:
    now = time.time() * 1000
    return sum(1 for s in data["sessions"].values() if now < s.get("expiresAt", 0) and now - s.get("lastSeenAt", 0) < 7 * 86400 * 1000)


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("command", choices=["status", "set", "reset", "backup"])
    ap.add_argument("--stdin", action="store_true", help="read the new password from standard input")
    args = ap.parse_args()
    data = load()

    if args.command == "status":
        print("password: " + ("set (since " + data["password"]["setAt"] + ")" if data.get("password") else "not set"))
        print(f"signed-in browsers: {live_sessions(data)}")
        print(f"protected backup: {backup_status()}")
        return 0

    if args.command == "backup":
        print(save_backup(data))
        return 0

    if args.command == "reset":
        data.pop("password", None)
        data.update({"sessions": {}, "attempts": {}, "globalAttempts": {"count": 0, "firstAt": 0}})
        save(data)
        mark_deliberate_reset()
        print("Password and every session removed. Sign-in from other computers is off until you run: scripts/devflow-password set")
        return 0

    if args.stdin:
        password = sys.stdin.readline().rstrip("\n")
    else:
        password = getpass.getpass("New password: ")
        if getpass.getpass("Again: ") != password:
            sys.exit("The two did not match. Nothing was changed.")
    why = problem(password)
    if why:
        sys.exit(why)
    data["password"] = {"hash": hash_password(password), "setAt": time.strftime("%Y-%m-%dT%H:%M:%S.000Z", time.gmtime())}
    data.update({"sessions": {}, "attempts": {}, "globalAttempts": {"count": 0, "firstAt": 0}})
    save(data)
    print("Password set. Every browser was signed out. " + save_backup(data).capitalize() + ".")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
