{
  "_about": "Shared by tests/unit/channel-tools.test.ts (lib/channel-tools.ts) and tests/test_channel_tools_index.py (scripts/channel-tools-index.py) so the two validators cannot drift. expect.tool lists fields that must match; expect.warning is a substring; expect.hidden means the tool is meant for other channels.",
  "channel": { "id": "c1", "name": "Commander" },
  "cases": [
    { "name": "link with whenToUse", "manifest": { "name": "Board", "type": "link", "url": "http://localhost:3000/tasks", "icon": "📋", "whenToUse": "  When Alex asks about tasks.  " }, "expect": { "tool": { "id": "t", "name": "Board", "type": "link", "url": "http://localhost:3000/tasks", "icon": "📋", "order": 100, "whenToUse": "When Alex asks about tasks." } } },
    { "name": "whenToUse is optional", "manifest": { "type": "link", "url": "/system" }, "expect": { "tool": { "name": "t", "url": "/system", "description": "" } } },
    { "name": "blank whenToUse ignored", "manifest": { "type": "link", "url": "/system", "whenToUse": "   " }, "expect": { "tool": { "name": "t" } } },
    { "name": "non-string whenToUse ignored", "manifest": { "type": "link", "url": "/system", "whenToUse": 5 }, "expect": { "tool": { "name": "t" } } },
    { "name": "html default entry", "manifest": { "name": "App", "type": "html" }, "expect": { "tool": { "type": "html", "entry": "index.html" } } },
    { "name": "html nested entry", "manifest": { "type": "html", "entry": "ui/main page.html" }, "expect": { "tool": { "entry": "ui/main page.html" } } },
    { "name": "script with cwd", "manifest": { "name": "Run", "type": "script", "run": "python3 app.py", "cwd": "src", "description": "d", "order": 3 }, "expect": { "tool": { "type": "script", "run": "python3 app.py", "cwd": "src", "description": "d", "order": 3 } } },
    { "name": "script dot cwd dropped", "manifest": { "type": "script", "run": "x", "cwd": "." }, "expect": { "tool": { "run": "x" } } },
    { "name": "infer link", "manifest": { "url": "https://example.com" }, "expect": { "tool": { "type": "link" } } },
    { "name": "infer script", "manifest": { "run": "node x.js" }, "expect": { "tool": { "type": "script" } } },
    { "name": "infer html", "manifest": { "entry": "a.html" }, "expect": { "tool": { "type": "html" } } },
    { "name": "invalid json", "manifest": "{nope", "expect": { "warning": "not valid JSON" } },
    { "name": "array", "manifest": "[]", "expect": { "warning": "JSON object" } },
    { "name": "no type", "manifest": {}, "expect": { "warning": "\"type\"" } },
    { "name": "bad type", "manifest": { "type": "exe" }, "expect": { "warning": "\"type\"" } },
    { "name": "link without url", "manifest": { "type": "link" }, "expect": { "warning": "url" } },
    { "name": "javascript url", "manifest": { "type": "link", "url": "javascript:alert(1)" }, "expect": { "warning": "url" } },
    { "name": "protocol-relative url", "manifest": { "type": "link", "url": "//evil.test" }, "expect": { "warning": "url" } },
    { "name": "file url", "manifest": { "type": "link", "url": "file:///etc/passwd" }, "expect": { "warning": "url" } },
    { "name": "html traversal entry", "manifest": { "type": "html", "entry": "../x.html" }, "expect": { "warning": "entry" } },
    { "name": "html non-html entry", "manifest": { "type": "html", "entry": "app.js" }, "expect": { "warning": "entry" } },
    { "name": "html dotfile entry", "manifest": { "type": "html", "entry": ".secret.html" }, "expect": { "warning": "entry" } },
    { "name": "script without run", "manifest": { "type": "script" }, "expect": { "warning": "run" } },
    { "name": "script escaping cwd", "manifest": { "type": "script", "run": "x", "cwd": "../.." }, "expect": { "warning": "cwd" } },
    { "name": "channels not a list", "manifest": { "type": "link", "url": "/x", "channels": "all" }, "expect": { "warning": "channels" } },
    { "name": "hidden for another channel", "manifest": { "type": "link", "url": "/x", "channels": ["Other"] }, "expect": { "hidden": true } },
    { "name": "visible by name", "manifest": { "type": "link", "url": "/x", "channels": ["commander"] }, "expect": { "tool": { "id": "t" } } },
    { "name": "visible by id", "manifest": { "type": "link", "url": "/x", "channels": ["c1"] }, "expect": { "tool": { "id": "t" } } },
    { "name": "empty channels list shows everywhere", "manifest": { "type": "link", "url": "/x", "channels": [] }, "expect": { "tool": { "id": "t" } } }
  ]
}
