{
  "name": "openflow-ai",
  "version": "0.1.0",
  "description": "Open-source workspace where a team of AI agents and you work together in shared channels, with a task board, memory and an API",
  "private": true,
  "scripts": {
    "dev": "next dev -H ${DEVFLOW_BIND_HOST:-127.0.0.1}",
    "dev:test": "DEVFLOW_DATA_DIR=data-test DEVFLOW_TEST_MODE=true next dev -H ${DEVFLOW_BIND_HOST:-127.0.0.1} --port 3100",
    "build": "./scripts/safe-build.sh",
    "build:unsafe": "unset TURBOPACK; next build --webpack",
    "build:test": "DEVFLOW_DATA_DIR=data-test DEVFLOW_TEST_MODE=true next build --webpack",
    "build:local": "next build --turbopack",
    "start": "next start -H ${DEVFLOW_BIND_HOST:-127.0.0.1}",
    "start:test": "DEVFLOW_DATA_DIR=data-test DEVFLOW_TEST_MODE=true next start -H ${DEVFLOW_BIND_HOST:-127.0.0.1} --port 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:all": "tsc --noEmit -p tsconfig.full.json",
    "test:setup": "mkdir -p data-test && cp data/*.json data-test/ 2>/dev/null || echo 'Created empty data-test directory'",
    "test": "NODE_ENV=development vitest run",
    "test:watch": "NODE_ENV=development vitest",
    "test:coverage": "NODE_ENV=development vitest run --coverage",
    "test:cu": "NODE_ENV=development vitest run tests/computer-use"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@azure/msal-node": "^7.1.1",
    "@daily-co/daily-js": "0.90.0",
    "@dnd-kit/core": "^6.3.1",
    "@pipecat-ai/client-js": "^1.13.1",
    "@pipecat-ai/small-webrtc-transport": "^1.10.8",
    "@supabase/supabase-js": "^2.100.0",
    "@tiptap/extension-hard-break": "3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-text": "3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/dompurify": "^3.0.5",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react-window": "^1.8.8",
    "@types/uuid": "^10.0.0",
    "an-array-of-english-words": "^2.0.0",
    "chokidar": "^3.6.0",
    "croner": "^10.0.1",
    "dompurify": "^3.3.3",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "framer-motion": "^12.31.0",
    "geist": "^1.7.0",
    "gray-matter": "^4.0.3",
    "hash-wasm": "^4.12.0",
    "html-to-image": "^1.11.13",
    "ignore": "^7.0.5",
    "lucide-react": "^0.562.0",
    "mermaid": "^11.14.0",
    "minisearch": "^7.2.0",
    "natural": "^8.1.0",
    "next": "16.4.3",
    "pg": "^8.20.0",
    "playwright": "^1.59.1",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "react-window": "^1.8.10",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "three": "0.186.0",
    "tiptap-markdown": "^0.9.0",
    "uuid": "^13.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "^4.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.1"
  }
}
